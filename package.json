{
  "name": "eventos-probolsas",
  "version": "2.0.0",
  "private": true,
  "description": "Assets del plugin Eventos Probolsas.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"assets/src/**/*.scss\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/eventos-probolsas vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "bootstrap": "^5.3.8",
    "notyf": "^3.10.0",
    "tippy.js": "^6.3.7",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wordpress/env": "^11.17.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "postcss-prefix-selector": "^2.2.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
